if (CSICS_BUILD_GEO)
    find_package(GeographicLib)
    if (NOT GeographicLib_FOUND)
        message(WARNING "GeographicLib library not found but CSICS_BUILD_GEO is ON.")
        set(CSICS_BUILD_GEO OFF)
    else()
        message(STATUS "Using GeographicLib for geodesic calculations.")
    endif()
endif()

if (CSICS_USE_MQTT)
    find_package(eclipse-paho-mqtt-c)
    if (NOT eclipse-paho-mqtt-c_FOUND)
        message(WARNING "Eclipse Paho MQTT C library not found but CSICS_USE_MQTT is ON.")
        set(CSICS_USE_MQTT OFF)
    else()
        find_package(OpenSSL)
        add_library(paho-mqtt-c INTERFACE)
        message(STATUS "Using Eclipse Paho MQTT C library for MQTT support.")
        if (NOT OpenSSL_FOUND)
            message(WARNING "OpenSSL library not found but Eclipse Paho MQTT C library requires it for SSL/TLS support.")
            target_link_libraries(paho-mqtt-c INTERFACE eclipse-paho-mqtt-c::paho-mqtt3a)
        else()
            message(STATUS "Using OpenSSL for SSL/TLS support in MQTT.")
            target_link_libraries(paho-mqtt-c INTERFACE eclipse-paho-mqtt-c::paho-mqtt3as OpenSSL::SSL OpenSSL::Crypto)
        endif()
    endif()
endif()

